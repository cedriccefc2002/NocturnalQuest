{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "tasks": {
    "init": "deno run --allow-read --allow-write init.ts",
    "mod_replace": "deno run --allow-read --allow-write mod_replace.ts",
    "build": "deno compile --allow-read --allow-write mod_replace.ts",
    "build-win": "deno compile --allow-read --allow-write --target=x86_64-pc-windows-msvc mod_replace.ts",
    "server": "deno run --allow-net --allow-read server.ts",
    "download": "deno run --allow-net --allow-read --allow-write download.ts",
    "hentai": "deno run --allow-env --unsafely-ignore-certificate-errors --allow-net --allow-read --allow-write e-hentai.org.ts",
    "hentai.check": "deno run --allow-env --unsafely-ignore-certificate-errors --allow-net --allow-read --allow-write e-hentai.org.check.ts",
    "e-hentai.book": "deno run --allow-env --unstable-kv --unsafely-ignore-certificate-errors --allow-net --allow-read --allow-write e-hentai.org/book.ts",
    "e-hentai.bookPage": "deno run --allow-env --unstable-kv --unsafely-ignore-certificate-errors --allow-net --allow-read --allow-write e-hentai.org/bookPage.ts",
    "e-hentai.imagePage": "deno run --allow-env --unstable-kv --unsafely-ignore-certificate-errors --allow-net --allow-read --allow-write e-hentai.org/imagePage.ts",
    "e-hentai.image": "deno run --allow-env --unstable-kv --unsafely-ignore-certificate-errors --allow-net --allow-read --allow-write e-hentai.org/image.ts",
    "e-hentai.indexImage": "deno run --allow-env --unstable-kv --unsafely-ignore-certificate-errors --allow-net --allow-read --allow-write e-hentai.org/indexImage.ts"
  },
  "imports": {
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "preact/": "https://esm.sh/preact@10.29.2/",
    "@std/assert": "jsr:@std/assert@1",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/toml": "jsr:@std/toml",
    "@std/fs/exists": "jsr:@std/fs/exists",
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom",
    "log4js": "npm:log4js",
    "imagemagick": "https://deno.land/x/imagemagick_deno@0.0.31/mod.ts"
  }
}